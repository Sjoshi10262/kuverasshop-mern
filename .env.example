# Kuveras MERN Application - Environment Configuration Template
# DO NOT store actual passwords or production credentials in this file.

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Replace with your actual MongoDB Atlas cluster credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kuverasshop?retryWrites=true&w=majority

# Security Secrets
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application Origin (CORS setup)
FRONTEND_URL=http://localhost:5173
